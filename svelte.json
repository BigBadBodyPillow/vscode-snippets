			"<div class=\"rainbow-line\"></div>",
			"",
			"<style>",
			".rainbow-line {",
				"--rainbow: linear-gradient(",
				"to left,",
				"#fef26a,",
				"#fe8462,",
				"#ff70cb,",
				"#d270ff,",
				"#743ad5,",
				"#709df8,",
